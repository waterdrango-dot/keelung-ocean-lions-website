    "minScore": 3,
    "maxShow": 3
  },
  "scoring": {
    "keyword": 2,
    "intent": 4
  },
  "_runtime_說明": {
    "local": "需要本機 Chrome／桌面版 LINE／地端 Codex／NAS，雲端 session 跑不動",
    "cloud": "資料來源在雲端或公開網路，雲端 session 可執行",
    "any": "純文書處理，兩邊都可以"
  },
